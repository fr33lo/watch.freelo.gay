{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "locale": false,
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/trpc/[trpc]",
      "regex": "^/api/trpc/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtrpc": "nxtPtrpc"
      },
      "namedRegex": "^/api/trpc/(?<nxtPtrpc>[^/]+?)(?:/)?$"
    },
    {
      "page": "/movies/[slug]",
      "regex": "^/movies/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/movies/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/sitemap/[id]",
      "regex": "^/sitemap/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/sitemap/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/tv-shows/[slug]",
      "regex": "^/tv\\-shows/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/tv\\-shows/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/watch/anime/[slug]",
      "regex": "^/watch/anime/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/watch/anime/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/watch/movie/[slug]",
      "regex": "^/watch/movie/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/watch/movie/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/watch/tv/[slug]",
      "regex": "^/watch/tv/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/watch/tv/(?<nxtPslug>[^/]+?)(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/anime",
      "regex": "^/anime(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/anime(?:/)?$"
    },
    {
      "page": "/favicon.ico",
      "regex": "^/favicon\\.ico(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/favicon\\.ico(?:/)?$"
    },
    {
      "page": "/home",
      "regex": "^/home(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/home(?:/)?$"
    },
    {
      "page": "/movies",
      "regex": "^/movies(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/movies(?:/)?$"
    },
    {
      "page": "/new-and-popular",
      "regex": "^/new\\-and\\-popular(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/new\\-and\\-popular(?:/)?$"
    },
    {
      "page": "/search",
      "regex": "^/search(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/search(?:/)?$"
    },
    {
      "page": "/sitemap.xml",
      "regex": "^/sitemap\\.xml(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/sitemap\\.xml(?:/)?$"
    },
    {
      "page": "/tv-shows",
      "regex": "^/tv\\-shows(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/tv\\-shows(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "i18n": {
    "locales": ["en"],
    "defaultLocale": "en"
  },
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}
